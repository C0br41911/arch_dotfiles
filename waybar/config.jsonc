  "clock": {
    "format": "{:%H:%M:%S}",
    "format-alt": "{:%a %d %b %Y %H:%M:%S}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "interval": 1,
//  "align": 1,
//  "fixed-center": true,
"calendar": {
  "mode": "month",
  "mode-mon-col": 3,
  "on-scroll": 1,
  "format": {
    "months":   "<span color='#e5e5e5'><b>{}</b></span>",
    "days":     "<span color='#eeeeee'>{}</span>",
    "weeks":    "<span color='#6b7280'>W{}</span>",
//      "weekdays": "<span color='#9ca3af'><b>{}</b></span>",
"weekdays": "<span color='#da9c34'><b>{}</b></span>",
"today":    "<span color='#ffffff'><b><u>{}</u></b></span>"
  }
},
"actions": {
  "on-click-right": "mode",
  "on-scroll-up": "shift_up",
  "on-scroll-down": "shift_down"
}
  },

