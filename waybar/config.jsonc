{
  "layer": "top",
  "position": "top",
    "modules-left": ["hyprland/workspaces", "custom/music"/*"group/music"*/ /*, "wlr/taskbar"*/],  /*"hyprland/submap", "group/music*/
    "modules-center": ["custom/weather", "clock" /*"custom/mako"*/],
    "modules-right": [/*"group/speed", "temperature", "group/usage",*/"group/more", "group/kbv", "group/conns", "group/powerg"],
    "hyprland/window": {
      "max-length": 50

    },

"hyprland/workspaces": {
  "format": "{icon}",
  "format-window-separator": "",
  "workspace-taskbar": {
    "enable": false,
    "update-active-window": true,
    "format": "{icon}",
    "icon-size": 17,
    "on-click-window": "activate"
  }
},

/*
"hyprland/workspaces": {
//    "format": "{icon}{windows}",
    "format": "{icon}{windows}",
    "format-window-separator": "",
    "workspace-taskbar": {
        "enable": true,
        "update-active-window": true,
        "format": "{icon}",
        "icon-size": 17,
        "on-click-window": "activate"
    }
},
*/

"wlr/taskbar": {
  "format": "{icon}",
  "icon-size": 14,
  "icon-theme": "Numix-Circle",
  "tooltip-format": "{title}",
  "on-click": "activate",
  "on-click-middle": "close",
  "ignore-list": [
    "Alacritty"
  ],
  "app_ids-mapping": {
    "firefoxdeveloperedition": "firefox-developer-edition"
  },
  "rewrite": {
    "Firefox Web Browser": "Firefox",
    "Foot Server": "Terminal"
  }
},

/**********************************************************************************************************************************************/


"power-profiles-daemon": {
  "format": "{icon}",
  "tooltip-format": "Profile: {profile}",
  "tooltip": true,
  "format-icons": {
    "power-saver": "󰌪",
    "balanced": "󰗑",
    "performance": "󰓅",
    "default": "󰗑"
  }
},


"group/more": {
  "orientation": "horizontal",
  "drawer": {
    "transition-duration": 500,
    "transition-left-to-right": true,
    "children-class": "more-drawer",
    "click-to-reveal": true
  },
  "modules": [
    "custom/moreicon",
    "group/speed",
    "group/usage",
    "temperature"
  ]
},

//⚫
//⧓
//⦁
//⟷
//⬌
"custom/moreicon": {
  "format": "⬌",
  "tooltip": false
},

/**************** USAGE ******************/
"group/usage": {
  "orientation": "horizontal",
  "modules": [
    "cpu",
    "memory"
  ]
},
"cpu": {
  "interval": 1,
  "format": " {usage:2}% ",
  "max-length": 10, 
  "on-click": "kitty -e btop -p 0",
  "min-width": 1
},
"memory": {
  "interval": 1,
  "format": " {:2}%",
  "max-length": 10,
  "on-click": "kitty -e htop"
},
/************** END USAGE  ****************/
"temperature": {
  // "thermal-zone": 2,
  // "hwmon-path": ["/sys/class/hwmon/hwmon1/temp1_input", "/sys/class/thermal/thermal_zone0/temp"],
  // "critical-threshold": 80,
  // "format-critical": "{temperatureC}°C ",
  "format": " {temperatureC:2}°C",
  "format-critical": "<span foreground='#e06c75'></span> {temperatureC:2}°C",
  "critical-threshold": 75,
  "interval": 1,
  "on-click": "kitty -e watch -n 1 sensors -A",
  "tooltip": false
},
/*********************** SPEED *********************************/
"group/speed": {
  "orientation": "horizontal",
  "modules": ["network#down", "network#up"],
//	"on-click": "kitty -e btop -p 3",
},
"network#down": {
  "interface": "wlan0",
  "interval": 1,
  "format": " {bandwidthDownBytes:>1}",
  "min-length": 12,
  "max-length": 12,
  "on-click": "kitty -e btop -p 3",
//  "tooltip": false
},
"network#up": {
  "interface": "wlan0",
  "interval": 1,
  "format": " {bandwidthUpBytes:>1}",
  "min-length": 12,
  "max-length": 12,
  "on-click": "kitty -e btop -p 3",
//  "tooltip": false 
},
/************************* END SPEED ***************************/

"custom/mako": {
  "exec": "~/.config/waybar/scripts/mako.sh",
  "return-type": "json",
  "interval": 2,
  "signal": 8,
  "format": "{icon} {text}",
  "format-icons": {
    "none": "󰂚",
    "notification": "󰂞",
    "dnd": "󰂛"
  },
  "on-click": "makoctl restore; pkill -RTMIN+8 waybar",
  "on-click-right": "makoctl dismiss -a; pkill -RTMIN+8 waybar",
  "on-click-middle": "makoctl mode -t do-not-disturb; pkill -RTMIN+8 waybar",
  "escape": true
},

"group/batteryd": {
  "orientation": "horizontal",
  "drawer": {
    "transition-duration": 500,
    "transition-left-to-right": false,
    "click-to-reveal": false
  },
  "modules": [
    "battery",
    "battery#d"
  ]
},


"battery": {
  "tooltip": false,
  "states": {
    "critical": 25
  },
  "format": "{icon} {capacity}%",
  "format-discharging-critical": "<span foreground='#e06c75'>{icon}</span> {capacity}%",
  "format-icons": {
    "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
  }
},

"battery#d": {
  "format-charging": "charging {time} ",
  "format-discharging": "discharging {time} ",
//  "format-full": "full ",
  "format-plugged": "plugged ",
  "format-time": "{H}h {M}m",
  "tooltip": false
},


"group/conns":{
  "orientation": "horizontal",
  "modules": [
    "group/bluetoothd",
    "group/wifid",
    "group/volume",
    "group/batteryd"
  ]
},

/****************************** BLUTOOTH **************************************/

"group/bluetoothd": {
  "orientation": "horizontal",
  "drawer": {
    "transition-duration": 500,
    "transition-left-to-right": false,
    "click-to-reveal": false
  },
  "modules": [
    "bluetooth",
    "bluetooth#d"
  ]
},

"bluetooth": {
  "format": " ",
  "format-on": " ",
  "format-off": " ",
  "format-disabled": " ",
  "format-connected": " ",
  "tooltip-format": "{controller_alias}: {status}",
  "tooltip-format-connected": "{device_enumerate}",
  "tooltip-format-enumerate-connected": "{device_alias}",
  "on-click": "kitty -e bluetui",
  "tooltip": false
},
"bluetooth#d": {
  "format": "{status} {num_connections} connected ",
  "tooltip": false
},

