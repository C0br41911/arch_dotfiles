/**************************** TOGGLE *********************************/
/*
"custom/toggle": {
    "format": "⚙",
    "on-click": "~/.config/waybar/scripts/toggle.sh toggle"
},
*/
/************************** END TOGGLE *******************************/



"group/connections": {
  "orientation": "horizontal",
  "modules": [
    "bluetooth",
    "network"
  ]
},





"group/kbv":{
  "orientation": "horizontal",
  "modules": [
    "power-profiles-daemon",
    "custom/kbd-backlight",	
    "backlight"
  ]
},

/*************************** BRIGHTNESS ******************************/

"group/brightness": {
  "orientation": "horizontal",
  "drawer": {
    "transition-duration": 500,
    "transition-left-to-right": false,
    "children-class": "brightness-pct",
    "click-to-reveal": false
  },
  "modules": [
    "backlight",
    "backlight#percent"
  ]
},



"backlight": {
  "device": "intel_backlight",
  "format": "{icon}",
  "format-icons": ["󰃞", "󰃟", "󰃝", "󰃠"],
  "tooltip": false,
  "states": {
    "b10": 10,
    "b20": 20,
    "b30": 30,
    "b40": 40,
    "b50": 50,
    "b60": 60,
    "b70": 70,
    "b80": 80,
    "b90": 90,
    "b100": 100
  },
  "on-click": "brightnessctl set +10%",
  "on-click-right": "brightnessctl set 10%-"
},



/*
"backlight": {
  "device": "intel_backlight",
  "format": "{icon}",
  "format-icons": ["󰃞", "󰃟", "󰃝", "󰃠"],
  "tooltip": false,
//  "scroll-step": 5,
//  "min-brightness": 5,
  "on-click": "brightnessctl set +10%",
  "on-click-right": "brightnessctl set 10-%"
},
*/



"backlight#percent": {
  "device": "intel_backlight",
  "format": "{percent}% ",
  "tooltip": false
},

/************************* END BRIGHTNESS *****************************/

/*************************** VOLUME ******************************/

"group/volume": {
  "orientation": "horizontal",
  "drawer": {
    "transition-duration": 500,
    "transition-left-to-right": false,
    "children-class": "volume-pct",
    "click-to-reveal": false
  },
  "modules": [
    "wireplumber",
    "wireplumber#percent"
  ]
},

"wireplumber": {
  "format": "{icon}",
//  "format-muted": "󰕿",
//  "format-muted": "󰝟",
"format-icons": {
  "default": ["󰕾"]
//    "default": ["󰕿", "󰖀", "󰕾"]
},
"tooltip": false,
"on-click": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
"on-click-right": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
"scroll-step": 5
},

"wireplumber#percent": {
  "format": "{volume}% ",
  "format-muted": "muted",
  "tooltip": false
},

/************************* END VOLUME *****************************/

/************************** KEYBOARD ******************************/


"custom/kbd-backlight": {
  "exec": "brightnessctl -m -d 'asus::kbd_backlight' | awk -F, '{gsub(/%/,\"\",$4); p=$4+0; c=\"off\"; if(p>=100)c=\"high\"; else if(p>=66)c=\"mid\"; else if(p>=33)c=\"low\"; printf \"{\\\"text\\\":\\\"%d\\\",\\\"percentage\\\":%d,\\\"class\\\":\\\"%s\\\"}\\n\", p,p,c}'",
  "return-type": "json",
  "format": "󰌌 ",
  "tooltip-format": "Keyboard backlight {}%",
  "interval": 2,
  "exec-on-event": true,
  "on-click": "brightnessctl -d 'asus::kbd_backlight' set +10%",
  "on-click-right": "brightnessctl -d 'asus::kbd_backlight' set 10%-",
  "tooltip": false
},

/************************ END KEYBOARD ****************************/

/*************************** POWER ********************************/

"group/powerg": {
  "orientation": "horizontal",
  "drawer": {
    "transition-duration": 500,
    "children-class": "not-power",
    "transition-left-to-right": false
  },
  "modules": [
    "custom/power",
    "custom/reboot",
    "custom/shutdown"
  ]
},

"custom/power": {
  "format": "⏼",
  "tooltip": false
},

"custom/reboot": {
  "format": "",
  "tooltip-format": "reboot", 
  "on-click": "reboot"
},

"custom/shutdown": {
  "format": "⏻",
  "tooltip-format": "shutdown", 
  "on-click": "shutdown now"
},

/************************ END POWER ****************************/



